{
  "load_direnv": "direct",
  "file_scan_exclusions": [
    "...",
    "**/.devenv",
    "**/.direnv",
    "**/target",
    "**/result",
    "**/result-*"
  ],
  "languages": {
    "Rust": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nix",
          "arguments": [
            "develop", "--impure", "-c", "rustfmt", "--edition", "2024"
          ]
        }
      }
    },
    "Nix": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nix",
          "arguments": ["develop", "--impure", "-c", "nixfmt"]
        }
      }
    },
    "Python": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nix",
          "arguments": [
            "develop", "--impure", "-c", "ruff", "format",
            "--stdin-filename", "{buffer_path}", "-"
          ]
        }
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allTargets": true,
          "extraArgs": ["--locked"]
        },
        "check": {
          "command": "clippy",
          "extraArgs": ["--", "-D", "warnings"]
        }
      }
    }
  }
}
